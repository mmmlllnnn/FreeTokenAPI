# FreeTokenAPI — local configuration
# Use your own web login tokens, not official API keys.
# Set at least one provider. Separate multiple tokens with commas.
DEEPSEEK_TOKENS=
QWEN_TOKENS=

# This service has no client API-key authentication. Keep it on loopback.
FREETOKENAPI_HOST=127.0.0.1
FREETOKENAPI_PORT=8000
FREETOKENAPI_TIMEOUT=60

# Whole DeepSeek attachment-preparation deadline: uploads, parsing, and retries.
FREETOKENAPI_FILE_PARSE_TIMEOUT_SECONDS=300

# Per-account official DeepSeek model capabilities (in-memory TTL, seconds).
FREETOKENAPI_MODEL_CONFIG_TTL_SECONDS=300

# Let clients such as Pi use the provider's native web search by default.
# Explicit request search=true/false overrides this opt-in setting.
FREETOKENAPI_SEARCH_ENABLED=1

# Optional privacy settings: disable persistent conversation cache / usage.
# FREETOKENAPI_CACHE_DISABLED=1
# FREETOKENAPI_USAGE_ENABLED=0

# Optional diagnostics. Leave the file path empty for console-only logging.
# FREETOKENAPI_LOG_LEVEL=INFO
# FREETOKENAPI_LOG_FILE=
